# =============================================================================
# Hermes Agent — Environment Variables (TEMPLATE)
# =============================================================================
# Copy this file to .env and fill in your actual API keys.
# WARNING: .env contains secrets — NEVER commit it to version control.

# DeepSeek API key (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Telegram Bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Gateway access control
# Set to "true" to allow all Telegram users (development only!)
GATEWAY_ALLOW_ALL_USERS=false
